{
  "name": "pulsewatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Serverless wearable monitoring for Fitbit Air: Google Health API → Cloudflare Workers → rules and personal baselines → Telegram.",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "demo": "tsx scripts/demo.ts",
    "secrets:init": "tsx scripts/secrets-init.ts",
    "oauth": "tsx scripts/oauth.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "types": "wrangler types --include-env=false",
    "db:migrate:local": "wrangler d1 migrations apply pulsewatch --local",
    "db:migrate:remote": "wrangler d1 migrations apply pulsewatch --remote",
    "deploy": "npm run check && wrangler d1 migrations apply pulsewatch --remote && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.141.0"
  }
}
